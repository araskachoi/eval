{
  "grader": "ledger-cli-v1",
  "max_turns": 5,
  "repair_prompt": "Revise your last submission to address the failed checks. Return only the complete updated ledger.py.",
  "protocols": {
    "independent": {},
    "guided": {
      "prompt_file": "guided-prompt.md",
      "repair_hints": {
        "legacy_show": "Check that show LEDGER parses the existing JSON array and prints balances.",
        "append_and_total": "After a valid batch, show must reopen a single JSON array containing the old and new rows, with signed amounts included in the totals.",
        "replay_across_invocations": "Two separate apply processes receive the same batch. The second must use IDs from the saved ledger and leave totals and rows unchanged.",
        "identical_duplicate_in_batch": "Identical repeats within a batch and against the ledger must each be a no-op.",
        "conflict_with_ledger": "Validate IDs against saved rows before writing. A conflicting saved ID leaves the original file byte-for-byte intact.",
        "conflict_within_batch": "An ID reused with different contents within a batch must reject the whole batch.",
        "malformed_row_rollback": "Validate every row before writing. Booleans are invalid even though Python treats bool as a subclass of int.",
        "malformed_json": "A batch that cannot be parsed must leave the original ledger byte-for-byte intact and exit nonzero.",
        "empty_batch": "An empty batch must succeed and print the existing balances."
      }
    }
  },
  "checks": {
    "legacy_show": {
      "ledger": [{"id": "old-1", "account": "checking", "amount_cents": 800}],
      "batch": [],
      "steps": [{"command": "show", "balances": {"checking": 800}}],
      "final": [{"id": "old-1", "account": "checking", "amount_cents": 800}]
    },
    "append_and_total": {
      "ledger": [{"id": "old-1", "account": "checking", "amount_cents": 800}],
      "batch": [{"id": "new-1", "account": "checking", "amount_cents": -125}, {"id": "new-2", "account": "savings", "amount_cents": 425}],
      "steps": [{"command": "apply", "balances": {"checking": 675, "savings": 425}}, {"command": "show", "balances": {"checking": 675, "savings": 425}}],
      "final": [{"id": "old-1", "account": "checking", "amount_cents": 800}, {"id": "new-1", "account": "checking", "amount_cents": -125}, {"id": "new-2", "account": "savings", "amount_cents": 425}]
    },
    "replay_across_invocations": {
      "ledger": [{"id": "old-1", "account": "checking", "amount_cents": 800}],
      "batch": [{"id": "new-1", "account": "checking", "amount_cents": -125}],
      "steps": [{"command": "apply", "balances": {"checking": 675}}, {"command": "apply", "balances": {"checking": 675}}],
      "final": [{"id": "old-1", "account": "checking", "amount_cents": 800}, {"id": "new-1", "account": "checking", "amount_cents": -125}]
    },
    "identical_duplicate_in_batch": {
      "ledger": [{"id": "old-1", "account": "checking", "amount_cents": 800}],
      "batch": [{"id": "old-1", "account": "checking", "amount_cents": 800}, {"id": "new-1", "account": "checking", "amount_cents": -125}, {"id": "new-2", "account": "savings", "amount_cents": 425}, {"id": "new-1", "account": "checking", "amount_cents": -125}],
      "steps": [{"command": "apply", "balances": {"checking": 675, "savings": 425}}],
      "final": [{"id": "old-1", "account": "checking", "amount_cents": 800}, {"id": "new-1", "account": "checking", "amount_cents": -125}, {"id": "new-2", "account": "savings", "amount_cents": 425}]
    },
    "conflict_with_ledger": {
      "ledger": [{"id": "old-1", "account": "checking", "amount_cents": 800}],
      "batch": [{"id": "new-2", "account": "savings", "amount_cents": 425}, {"id": "old-1", "account": "checking", "amount_cents": 123}],
      "steps": [{"command": "apply", "balances": null}],
      "final": null,
      "positive_control": "append_and_total"
    },
    "conflict_within_batch": {
      "ledger": [{"id": "old-1", "account": "checking", "amount_cents": 800}],
      "batch": [{"id": "new-1", "account": "checking", "amount_cents": -125}, {"id": "new-1", "account": "checking", "amount_cents": 90}],
      "steps": [{"command": "apply", "balances": null}],
      "final": null,
      "positive_control": "append_and_total"
    },
    "malformed_row_rollback": {
      "ledger": [{"id": "old-1", "account": "checking", "amount_cents": 800}],
      "batch": [{"id": "new-1", "account": "checking", "amount_cents": -125}, {"id": "new-2", "account": "savings", "amount_cents": true}],
      "steps": [{"command": "apply", "balances": null}],
      "final": null,
      "positive_control": "append_and_total"
    },
    "malformed_json": {
      "ledger": [{"id": "old-1", "account": "checking", "amount_cents": 800}],
      "batch": "[",
      "steps": [{"command": "apply", "balances": null}],
      "final": null,
      "positive_control": "append_and_total"
    },
    "empty_batch": {
      "ledger": [{"id": "old-1", "account": "checking", "amount_cents": 800}],
      "batch": [],
      "steps": [{"command": "apply", "balances": {"checking": 800}}],
      "final": [{"id": "old-1", "account": "checking", "amount_cents": 800}]
    }
  }
}
